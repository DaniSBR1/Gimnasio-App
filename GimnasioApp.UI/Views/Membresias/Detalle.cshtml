@model MembresiaDetalleViewModel
@{
    ViewData["Title"] = "Detalle de Membresía";
}

<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">Detalle de Membresía</h1>
        <p class="page-subtitle">Información completa de la membresía #@Model.Id</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-outline">← Volver al listado</a>
    </div>
</div>

<div class="card detail-card">
    <div class="detail-header">
        <div class="detail-avatar">@Model.Nombre[0]@Model.Apellidos[0]</div>
        <div class="detail-title-info">
            <h2>@Model.Nombre @Model.Apellidos</h2>
            <p>@Model.Identificacion</p>
        </div>
        <span class="badge badge-lg @(Model.EstadoId == 1 ? "badge-activa" : "badge-vencida")">
            @Model.Estado
        </span>
    </div>

    <div class="detail-grid">
        <div class="detail-item">
            <span class="detail-label">Identificación</span>
            <span class="detail-value">@Model.Identificacion</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Nombre</span>
            <span class="detail-value">@Model.Nombre</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Apellidos</span>
            <span class="detail-value">@Model.Apellidos</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Teléfono</span>
            <span class="detail-value">@Model.Telefono</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Tipo de Plan</span>
            <span class="detail-value"><span class="badge badge-plan">@Model.TipoDePlan</span></span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Precio Base Mensual</span>
            <span class="detail-value">₡ @Model.PrecioBaseMensual.ToString("N2")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Fecha de Inicio</span>
            <span class="detail-value">@Model.FechaDeInicio</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Fecha de Vencimiento</span>
            <span class="detail-value">@Model.FechaDeVencimiento</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Estado</span>
            <span class="detail-value">
                <span class="badge @(Model.EstadoId == 1 ? "badge-activa" : "badge-vencida")">@Model.Estado</span>
            </span>
        </div>
        <div class="detail-item detail-item-highlight">
            <span class="detail-label">Monto Total</span>
            <span class="detail-value detail-value-amount">₡ @Model.MontoTotal.ToString("N2")</span>
        </div>
    </div>
</div>
