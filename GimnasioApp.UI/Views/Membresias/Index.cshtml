@model List<MembresiaListadoViewModel>
@{
    ViewData["Title"] = "Membresías Registradas";
}

<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">Membresías Registradas</h1>
        <p class="page-subtitle">Listado completo de membresías en el sistema</p>
    </div>
    <a asp-action="Agregar" class="btn btn-primary">
        + Agregar Membresía
    </a>
</div>

<div class="card">
    <form method="get" asp-action="Index" class="filter-form">
        <div class="filter-group">
            <label for="identificacion" class="filter-label">Filtrar por identificación</label>
            <div class="filter-controls">
                <input type="text"
                       id="identificacion"
                       name="identificacion"
                       value="@ViewBag.Identificacion"
                       placeholder="Ingrese la identificación del cliente..."
                       class="input-text" />
                <button type="submit" class="btn btn-secondary">Buscar</button>
                @if (!string.IsNullOrEmpty(ViewBag.Identificacion as string))
                {
                    <a asp-action="Index" class="btn btn-outline">Limpiar</a>
                }
            </div>
        </div>
    </form>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">📋</span>
            <p>No se encontraron membresías registradas.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Identificación</th>
                        <th>Nombre Completo</th>
                        <th>Tipo de Plan</th>
                        <th>Fecha de Inicio</th>
                        <th>Fecha de Vencimiento</th>
                        <th>Estado</th>
                        <th>Monto Total</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td>@m.Identificacion</td>
                            <td>@m.NombreCompleto</td>
                            <td><span class="badge badge-plan">@m.TipoDePlan</span></td>
                            <td>@m.FechaDeInicio</td>
                            <td>@m.FechaDeVencimiento</td>
                            <td>
                                <span class="badge @(m.Estado == "Activa" ? "badge-activa" : "badge-vencida")">
                                    @m.Estado
                                </span>
                            </td>
                            <td class="text-right">₡ @m.MontoTotal.ToString("N2")</td>
                            <td>
                                <div class="action-buttons">
                                    <a asp-action="Detalle" asp-route-id="@m.Id" class="btn btn-sm btn-info">Detalle</a>
                                    <a asp-action="Editar" asp-route-id="@m.Id" class="btn btn-sm btn-warning">Editar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span class="record-count">Total: @Model.Count registro(s)</span>
        </div>
    }
</div>
